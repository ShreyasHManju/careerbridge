# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="CareerBridge"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==========================================
# Security & JWT Credentials
# ==========================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=internship_db
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/internship_db

# ==========================================
# CORS Settings
# ==========================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==========================================
# File Uploads / Storage
# ==========================================
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
