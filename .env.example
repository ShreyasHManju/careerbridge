# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="CareerBridge"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==========================================
# Security & JWT Credentials
# ==========================================
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=internship_db
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/internship_db

# ==========================================
# CORS Settings
# ==========================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==========================================
# File Uploads / Storage
# ==========================================
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# ==========================================
# Email Notification Configuration
# ==========================================
EMAIL_PROVIDER="local"  # "local" for dev/testing (in-memory) or "smtp" for production
EMAIL_FROM="no-reply@careerbridge.io"
EMAIL_FROM_NAME="CareerBridge"
SMTP_HOST=smtp.mailgun.org  # or smtp.sendgrid.net, etc.
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=True
FRONTEND_URL="http://localhost:5173"

