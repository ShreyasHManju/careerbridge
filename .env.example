# ==============================================================================
# CareerBridge — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to Git.
# ==============================================================================

# ==========================================
# 1. Application Configuration
# ==========================================
PROJECT_NAME="CareerBridge"
ENVIRONMENT="development"       # "development", "test", or "production"
DEBUG=True                     # MUST be False in production
API_V1_STR="/api/v1"

# ==========================================
# 2. Port Bindings (Docker Compose)
# ==========================================
# Port on host mapped to backend container (8000 internally, bound to 127.0.0.1)
BACKEND_PORT=8000
# Port on host mapped to frontend Nginx container (80 internally)
FRONTEND_PORT=80

# ==========================================
# 3. Security & JWT Credentials
# ==========================================
# In production, generate a 32+ character high-entropy key:
#   Linux/macOS/Git Bash: openssl rand -hex 32
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==========================================
# 4. Database Configuration (PostgreSQL 16)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost        # In Docker Compose, this is overridden to "db"
POSTGRES_PORT=5432
POSTGRES_DB=internship_db
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/internship_db

# ==========================================
# 5. CORS Settings
# ==========================================
# Comma-separated list or JSON array of allowed origins. Wildcards (*) prohibited in production.
# Localhost/Dev: "http://localhost:5173,http://127.0.0.1:5173,http://localhost:80"
# LAN Testing:   "http://192.168.1.50,http://192.168.1.50:8080"
# Production:    "https://careerbridge.yourdomain.com"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==========================================
# 6. File Storage Configuration
# ==========================================
# ------------------------------------------------------------------------------
# PROFILE A: ₹0 Self-Hosted Local Persistent Storage (Zero Cloud Cost)
# ------------------------------------------------------------------------------
# In production, stores uploads locally on persistent Docker volume (/app/uploads).
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
MAX_RESUME_SIZE_MB=5
MAX_PROFILE_IMAGE_SIZE_MB=2

# ------------------------------------------------------------------------------
# PROFILE B: Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# Uncomment and configure if using cloud/S3-compatible object storage:
# STORAGE_PROVIDER="s3"
# STORAGE_BUCKET=your_s3_bucket_name
# STORAGE_REGION="us-east-1"
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # Optional (for Cloudflare R2 / MinIO)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id                         # Optional if using AWS IAM Roles
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key                 # Optional if using AWS IAM Roles

# ==========================================
# 7. Email Notification Configuration
# ==========================================
EMAIL_PROVIDER="local"          # "local" (in-memory dev logger) or "smtp" (production)
EMAIL_FROM="no-reply@careerbridge.io"
EMAIL_FROM_NAME="CareerBridge"
SMTP_HOST=smtp.mailgun.org      # or smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=True
FRONTEND_URL="http://localhost:5173"

# ==========================================
# 8. Optional Remote Access (Cloudflare Tunnel)
# ==========================================
# Required only when deploying with docker-compose.tunnel.yml
# Obtain from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
# Never commit your actual tunnel token to version control.
TUNNEL_TOKEN=
