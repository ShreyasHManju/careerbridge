# ==============================================================================
# CareerBridge Nginx Reverse Proxy Configuration Template
# ==============================================================================
# File: deploy/nginx/careerbridge.conf.example
#
# PURPOSE:
# Configures Nginx on the host (e.g., Ubuntu EC2) to:
# 1. Provide an initial HTTP endpoint on Port 80 for Let's Encrypt ACME webroot challenges.
# 2. Terminate SSL/TLS on Port 443 with Let's Encrypt certificates (after certificate issuance).
# 3. Redirect all unencrypted HTTP traffic to HTTPS once TLS is enabled.
# 4. Serve the production React SPA frontend statically with client-side SPA routing fallback.
# 5. Proxy REST API traffic (/api/, /health, /docs, /redoc, /openapi.json) to FastAPI (127.0.0.1:8000).
# 6. Handle persistent real-time WebSocket connections (/api/v1/ws/) with protocol upgrades.
#
# ==============================================================================
# SAFE FIRST-DEPLOYMENT SEQUENCE (TWO PHASES):
# ==============================================================================
# On a fresh EC2 instance, SSL certificate files (/etc/letsencrypt/live/YOUR_DOMAIN/...)
# do NOT exist initially. The HTTPS block below is INTENTIONALLY COMMENTED OUT so that
# 'nginx -t' succeeds on a clean host before certificates are created.
#
# ------------------------------------------------------------------------------
# PHASE A — INITIAL HTTP SETUP & CERTIFICATE ISSUANCE (WEBROOT METHOD):
# ------------------------------------------------------------------------------
# 1. Copy this template to sites-available:
#      sudo cp /opt/careerbridge/deploy/nginx/careerbridge.conf.example /etc/nginx/sites-available/careerbridge.conf
#
# 2. Replace 'YOUR_DOMAIN' with your actual domain (e.g. careerbridge.example.com):
#      sudo sed -i 's/YOUR_DOMAIN/careerbridge.example.com/g' /etc/nginx/sites-available/careerbridge.conf
#
# 3. Create the ACME challenge webroot directory:
#      sudo mkdir -p /var/www/certbot
#
# 4. Enable the HTTP site and test Nginx:
#      sudo ln -sf /etc/nginx/sites-available/careerbridge.conf /etc/nginx/sites-enabled/
#      sudo rm -f /etc/nginx/sites-enabled/default
#      sudo nginx -t
#      sudo systemctl reload nginx
#
# 5. Obtain your first certificate using the Certbot webroot authenticator:
#      sudo certbot certonly \
#        --webroot \
#        -w /var/www/certbot \
#        -d YOUR_DOMAIN \
#        -m YOUR_EMAIL \
#        --agree-tos
#
# ------------------------------------------------------------------------------
# PHASE B — ENABLE PRODUCTION HTTPS & WEBSOCKETS:
# ------------------------------------------------------------------------------
# 1. After Certbot successfully creates the certificate files in /etc/letsencrypt/live/YOUR_DOMAIN/,
#    edit /etc/nginx/sites-available/careerbridge.conf and UNCOMMENT the entire HTTPS server block
#    (Section 2 below).
#
# 2. Validate configuration syntax:
#      sudo nginx -t
#
# 3. Reload Nginx to activate HTTPS, SPA hosting, API proxying, and WebSockets:
#      sudo systemctl reload nginx
#
# 4. HTTP traffic on Port 80 will now automatically redirect to HTTPS on Port 443.
# ==============================================================================

# Map directive for standard WebSocket connection upgrades
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstream definition for the containerized FastAPI backend
upstream careerbridge_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

# ------------------------------------------------------------------------------
# 1. HTTP Server (Port 80) — Active by Default for ACME Challenges & Redirection
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Allow Let's Encrypt / Certbot ACME challenge verification over HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all other HTTP traffic to HTTPS (once HTTPS server block is active)
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. HTTPS Server (Port 443) — Production SSL Termination, SPA Hosting & API Proxy
# ------------------------------------------------------------------------------
# IMPORTANT DEPLOYMENT SAFETY NOTICE:
# The HTTPS server block below is INTENTIONALLY COMMENTED OUT for initial deployment.
# Do NOT uncomment this block until Certbot has successfully issued your certificates
# to /etc/letsencrypt/live/YOUR_DOMAIN/.
#
# After obtaining certificates via Phase A above:
# 1. Uncomment all lines in the server block below.
# 2. Run: sudo nginx -t
# 3. Run: sudo systemctl reload nginx
# ------------------------------------------------------------------------------

# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name YOUR_DOMAIN;
#
#     # --------------------------------------------------------------------------
#     # SSL/TLS Certificate Configuration (Managed by Certbot)
