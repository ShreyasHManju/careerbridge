# ==============================================================================
# CareerBridge Nginx Reverse Proxy Configuration Template
# ==============================================================================
# File: deploy/nginx/careerbridge.conf.example
#
# PURPOSE:
# Configures Nginx on the host (e.g., Ubuntu EC2) to terminate SSL/TLS,
# forward API traffic to the CareerBridge FastAPI container (127.0.0.1:8000),
# and route persistent WebSocket connections with appropriate upgrade headers.
#
# INSTRUCTIONS:
# 1. Copy this file to /etc/nginx/sites-available/careerbridge.conf
# 2. Replace all placeholder values (e.g., api.yourdomain.example.com).
# 3. Create a symbolic link in /etc/nginx/sites-enabled/
# 4. Test configuration: sudo nginx -t
# 5. Reload Nginx: sudo systemctl reload nginx
# ==============================================================================

# Map directive for standard WebSocket connection upgrades
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstream definition for the containerized FastAPI backend
upstream careerbridge_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

# ------------------------------------------------------------------------------
# 1. HTTP Server — Redirect all unencrypted traffic to HTTPS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.example.com;

    # Allow Let's Encrypt / Certbot ACME challenge verification over HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. HTTPS Server — SSL Termination, Reverse Proxy & WebSocket Handling
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.yourdomain.example.com;

    # --------------------------------------------------------------------------
    # SSL/TLS Certificate Configuration (Placeholders — Managed by Certbot)
    # --------------------------------------------------------------------------
    ssl_certificate /etc/letsencrypt/live/api.yourdomain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.yourdomain.example.com/privkey.pem;

    # Recommended TLS Security Protocols & Ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --------------------------------------------------------------------------
    # Request Body Size Limitation
    # --------------------------------------------------------------------------
    # CareerBridge permits resumes up to 5MB and profile images up to 2MB.
    # Set client_max_body_size to 10M to accommodate multipart upload overhead.
    client_max_body_size 10M;

    # --------------------------------------------------------------------------
    # Logging Configuration
    # --------------------------------------------------------------------------
    access_log /var/log/nginx/careerbridge_access.log;
    error_log /var/log/nginx/careerbridge_error.log warn;

    # --------------------------------------------------------------------------
    # Standard REST API Routing
    # --------------------------------------------------------------------------
    location / {
        proxy_pass http://careerbridge_backend;
        proxy_http_version 1.1;

        # Standard Proxy Headers for Client Identification & Scheme Preservation
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # API Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }

    # --------------------------------------------------------------------------
    # Real-Time WebSocket Messaging Route
    # --------------------------------------------------------------------------
    location /api/v1/ws/ {
        proxy_pass http://careerbridge_backend;
        proxy_http_version 1.1;

        # WebSocket Protocol Upgrade Headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Client Identity Preservation for Authentication and Rate Limiting
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Extended Timeouts for Long-Lived WebSocket Connections
        # Prevents proxy from prematurely terminating idle chat connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Disable buffering for real-time WebSocket communication
        proxy_buffering off;
    }
}
