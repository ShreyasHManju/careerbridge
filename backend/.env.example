# ==============================================================================
# CareerBridge Backend Environment Configuration Template
# ==============================================================================
# Copy this template to .env (in the project root or backend/.env) to configure.
# In production, inject these variables via your orchestrator or secure secret store.
# NEVER commit files containing real passwords or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS (Optional - sensible defaults provided)
# ------------------------------------------------------------------------------
PROJECT_NAME=CareerBridge
ENVIRONMENT=development                # Set to 'production' in live deployments
DEBUG=True                             # MUST be set to False in production
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (MANDATORY - MUST BE CONFIGURED)
# ------------------------------------------------------------------------------
# Secret cryptographic key used to sign and verify JWT access tokens.
# Generate a cryptographically secure 64-character hex key using:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection credentials (used by local and Docker Compose setups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_HOST=localhost                # Use 'db' when running inside Docker Compose network
POSTGRES_PORT=5432
POSTGRES_DB=internship_db

# Optional explicit DATABASE_URL (takes precedence over individual POSTGRES_* variables)
# Common for managed cloud database providers (Neon, Supabase, Render, Railway, AWS RDS)
# Both 'postgresql://' and 'postgres://' schemes are automatically supported and normalized.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING (MANDATORY FOR PRODUCTION DEPLOYMENTS)
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed frontend web origins.
# In production, replace with your live frontend domain (e.g. "https://careerbridge.example.com").
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Base URL of the frontend application (used for generating links in emails & notifications)
FRONTEND_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 5. STORAGE & FILE UPLOADS (Optional - defaults to container/local filesystem)
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=5
MAX_PROFILE_IMAGE_SIZE_MB=2

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL SETTINGS (Optional - defaults to local logging provider)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=local                   # 'local' for development/testing, 'smtp' for live delivery
EMAIL_FROM=no-reply@careerbridge.io
EMAIL_FROM_NAME=CareerBridge

# SMTP credentials (required only when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & BRUTE FORCE DEFENSE (Optional - defaults enabled)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_ENABLED=True
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
