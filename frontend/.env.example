# ==============================================================================
# CareerBridge Frontend Environment Variables Template
# ==============================================================================
# In local development:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# In production with unified Nginx reverse proxy (same-origin):
#   VITE_API_BASE_URL=/api/v1
#
# In production with dedicated API domain/subdomain:
#   VITE_API_BASE_URL=https://YOUR_DOMAIN/api/v1
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
